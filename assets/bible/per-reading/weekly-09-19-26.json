  "gospel": {
    "passage": "Luke 21:1-4",
    "chunks": [
      "Luke 21:1-4"
    ],
    "versions": {
      "leb": [
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 1,
          "text": "A Poor Widow’s Offering\nAnd he looked up and saw the rich putting their gifts into the contribution box,",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 2,
          "text": "and he saw a certain poor widow putting in there two small copper coins.",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 3,
          "text": "And he said, “Truly I say to you that this poor widow put in more than all of them.",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 4,
          "text": "For these all put gifts into the offering out of their abundance, but this woman out of her poverty put in all the means of subsistence that she had.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 1,
          "text": "The Widow’s Offering\nAs Jesus looked up, he saw rich people putting their gifts into the temple offering boxes.",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 2,
          "text": "He also saw a poor widow put in two very small copper coins.",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 3,
          "text": "“What I’m about to tell you is true,” Jesus said. “That poor widow has put in more than all the others.",
          "isHeading": false
        },
        {
          "book": "Luke",
          "chapter": 21,
          "verse": 4,
          "text": "All of those other people gave a lot because they are rich. But even though she is poor, she put in everything. She had nothing left to live on.”",
          "isHeading": false
        }
      ],
