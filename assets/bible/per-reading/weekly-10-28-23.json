  "gospel": {
    "passage": "Mark 4:26 - 4:29",
    "chunks": [
      "Mark 4:26 - 4:29"
    ],
    "versions": {
      "leb": [
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 26,
          "text": "The Parable of the Seed that Grows by Itself\nAnd he said, “The kingdom of God is like this: like a man scatters seed on the ground.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 27,
          "text": "And he sleeps and gets up, night and day, and the seed sprouts and grows—he does not know how.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 28,
          "text": "By itself the soil produces a crop: first the grass, then the head of grain, then the full grain in the head.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 29,
          "text": "But when the crop permits, he sends in the sickle right away, because the harvest has come.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 26,
          "text": "The Story of the Growing Seed\nJesus also said, “Here is what God’s kingdom is like. A farmer scatters seed on the ground.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 27,
          "text": "Night and day the seed comes up and grows. It happens whether the farmer sleeps or gets up. He doesn’t know how it happens.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 28,
          "text": "All by itself the soil produces grain. First the stalk comes up. Then the head appears. Finally, the full grain appears in the head.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 4,
          "verse": 29,
          "text": "Before long the grain ripens. So the farmer cuts it down, because the harvest is ready.”",
          "isHeading": false
        }
      ],
