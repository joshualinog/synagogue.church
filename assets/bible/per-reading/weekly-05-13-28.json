  "gospel": {
    "passage": "Acts 20:28 - 20:31",
    "chunks": [
      "Acts 20:28 - 20:31"
    ],
    "versions": {
      "leb": [
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 28,
          "text": "Be on guard for yourselves and for all the flock among which the Holy Spirit has appointed you as overseers, to shepherd the church of God which he obtained through the blood of his own Son.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 29,
          "text": "I know that after my departure fierce wolves will come in among you, not sparing the flock.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 30,
          "text": "And from among you yourselves men will arise, speaking perversions of the truth in order to draw away the disciples after them.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 31,
          "text": "Therefore be on the alert, remembering that night and day for three years I did not stop warning each one of you with tears.",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 28,
          "text": "“Keep watch over yourselves. Keep watch over all the believers. The Holy Spirit has made you leaders over them. Be shepherds of God’s church. He bought it with his own blood.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 29,
          "text": "“I know that after I leave, wild wolves will come in among you. They won’t spare any of the sheep.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 30,
          "text": "Even men from your own people will rise up and twist the truth. They want to get the believers to follow them.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 20,
          "verse": 31,
          "text": "So be on your guard! Remember that for three years I never stopped warning you. Night and day I warned each of you with tears.",
          "isHeading": false
        }
      ],
