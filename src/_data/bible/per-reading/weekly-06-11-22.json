  "gospel": {
    "passage": "John 8:31-8:38",
    "chunks": [
      "John 8:31-8:38"
    ],
    "versions": {
      "leb": [
        {
          "book": "John",
          "chapter": 8,
          "verse": 31,
          "text": "The Truth Will Set You Free\nThen Jesus said to those Jews who had believed him, “If you continue in my word you are truly my disciples,",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 32,
          "text": "and you will know the truth, and the truth will set you free.”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 33,
          "text": "They replied to him, “We are descendants of Abraham and have not been enslaved to anyone at any time. How do you say, ‘You will become free’?”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 34,
          "text": "Jesus replied to them, “Truly, truly I say to you, that everyone who commits sin is a slave of sin.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 35,
          "text": "And the slave does not remain in the household forever; the son remains forever.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 36,
          "text": "So if the son sets you free, you will be truly free.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 37,
          "text": "I know that you are descendants of Abraham. But you are seeking to kill me, because my word makes no progress among you.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 38,
          "text": "I speak the things that I have seen with the Father; so also you do the things that you have heard from the Father.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "John",
          "chapter": 8,
          "verse": 31,
          "text": "The Children of Abraham\nJesus spoke to the Jews who had believed him. “If you obey my teaching,” he said, “you are really my disciples.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 32,
          "text": "Then you will know the truth. And the truth will set you free.”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 33,
          "text": "They answered him, “We are Abraham’s children. We have never been slaves of anyone. So how can you say that we will be set free?”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 34,
          "text": "Jesus replied, “What I’m about to tell you is true. Everyone who sins is a slave of sin.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 35,
          "text": "A slave has no lasting place in the family. But a son belongs to the family forever.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 36,
          "text": "So if the Son of Man sets you free, you will really be free.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 37,
          "text": "“I know you are Abraham’s children. But you are ready to kill me. You have no room for my word.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 8,
          "verse": 38,
          "text": "I am telling you what I saw when I was with my Father. You do what you have heard from your father.”",
          "isHeading": false
        }
      ],
