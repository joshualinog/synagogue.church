  "gospel": {
    "passage": "Acts 28:11 - 28:16",
    "chunks": [
      "Acts 28:11 - 28:16"
    ],
    "versions": {
      "leb": [
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 11,
          "text": "Paul Arrives in Rome at Last\nNow after three months we put out to sea in a ship that had wintered at the island, an Alexandrian one with the twin gods Castor and Pollux as its insignia.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 12,
          "text": "And putting in at Syracuse, we stayed there three days.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 13,
          "text": "From there we got underway and arrived at Rhegium, and after one day a south wind came up and on the second day we came to Puteoli,",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 14,
          "text": "where we found brothers, and were implored to stay with them seven days. And in this way we came to Rome.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 15,
          "text": "And from there the brothers, when they heard the news about us, came to meet us as far as the Forum of Appius and Three Taverns. When he saw them, Paul gave thanks to God and took courage.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 16,
          "text": "And when we entered into Rome, Paul was allowed to stay by himself with the soldier who was guarding him.",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 11,
          "text": "Paul Arrives in Rome\nAfter three months we headed out to sea. We sailed in a ship that had stayed at the island during the winter. It was a ship from Alexandria. On the front of it the figures of twin gods were carved. Their names were Castor and Pollux.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 12,
          "text": "We landed at Syracuse and stayed there for three days.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 13,
          "text": "From there we sailed to Rhegium. The next day the south wind came up. The day after that, we reached Puteoli.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 14,
          "text": "There we found some believers. They invited us to spend a week with them.\nAt last we came to Rome.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 15,
          "text": "The brothers and sisters there had heard we were coming. They traveled as far as the Forum of Appius and the Three Taverns to meet us. When Paul saw these people, he thanked God and was cheered up.",
          "isHeading": false
        },
        {
          "book": "Acts",
          "chapter": 28,
          "verse": 16,
          "text": "When we got to Rome, Paul was allowed to live by himself. But a soldier guarded him.",
          "isHeading": false
        }
      ],
