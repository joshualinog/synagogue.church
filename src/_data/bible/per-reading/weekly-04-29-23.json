  "gospel": {
    "passage": "John 20:19 - 23",
    "chunks": [
      "John 20:19 - 23"
    ],
    "versions": {
      "leb": [
        {
          "book": "John",
          "chapter": 20,
          "verse": 19,
          "text": "Jesus Appears to the Disciples\nNow when it was evening on that day—the first day of the week—and the doors had been shut where the disciples were because of fear of the Jews, Jesus came and stood in their midst and said to them, “Peace to you.”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 20,
          "text": "And when he had said this, he showed his hands and his side to them. Then the disciples rejoiced when they saw the Lord.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 21,
          "text": "So Jesus said to them again, “Peace to you. As the Father has sent me, I also send you.”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 22,
          "text": "And when he had said this, he breathed on them and said to them, “Receive the Holy Spirit.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 23,
          "text": "If you forgive the sins of any, they are forgiven them. If you retain the sins of any, they are retained.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "John",
          "chapter": 20,
          "verse": 19,
          "text": "Jesus Appears to His Disciples\nOn the evening of that first day of the week, the disciples were together. They had locked the doors because they were afraid of the Jews.\nJesus came in and stood among them. He said, “May peace be with you!”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 20,
          "text": "Then he showed them his hands and his side. The disciples were very happy when they saw the Lord.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 21,
          "text": "Again Jesus said, “May peace be with you! The Father has sent me. So now I am sending you.”",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 22,
          "text": "He then breathed on them. He said, “Receive the Holy Spirit.",
          "isHeading": false
        },
        {
          "book": "John",
          "chapter": 20,
          "verse": 23,
          "text": "If you forgive anyone’s sins, they are forgiven. If you do not forgive them, they are not forgiven.”",
          "isHeading": false
        }
      ],
