{# Minimal passages include: server-render LEB from per-reading _data when available. No inline JS to avoid Nunjucks compilation issues. #}
{# expects `reading` in context #}
{% set slug = '' %}
{% if reading is defined and reading.slug is defined %}
  {% set slug = reading.slug %}
{% elif data.fileSlug is defined %}
  {% set slug = data.fileSlug %}
{% endif %}

{# Try several lookup patterns: data['bible/per-reading/<slug>'], data.bible['per-reading'][slug], or data[slug] if included directly #}
{% set pr = none %}
{% set perReadingKey = 'bible/per-reading/' ~ slug %}
{# Try top-level `bible` data (Eleventy often exposes nested _data folders as top-level vars) #}
{% if bible is defined and bible['per-reading'] is defined and bible['per-reading'][slug] is defined %}
  {% set pr = bible['per-reading'][slug] %}
{% elif data[perReadingKey] is defined %}
  {% set pr = data[perReadingKey] %}
{% elif data.bible is defined and data.bible['per-reading'] is defined and data.bible['per-reading'][slug] is defined %}
  {% set pr = data.bible['per-reading'][slug] %}
{% elif data[slug] is defined %}
  {% set pr = data[slug] %}
{% endif %}

{# NOTE: temporary debug removed. We use top-level `bible` lookup first, which Eleventy exposes for nested _data dirs. #}

{% macro renderSection(sectionKey, sectionLabel, sectionData) %}
  {% if sectionData and sectionData.passage %}
    <h2 class="text-xl font-bold mt-6">{{ sectionLabel }} — {{ sectionData.passage }}</h2>
    <div class="bible-block" data-section="{{ sectionKey }}">
      <div class="version-group">
        <h3 class="sr-only">LEB translation</h3>
        <div class="version leb">
          {% if sectionData.versions.leb %}
            {% set prevBook = "" %}
            {% set chunkIndex = 0 %}
            {% set sectionChunks = sectionData.chunks | default([]) %}
            {% for v in sectionData.versions.leb %}
              {% if v.book and v.book != prevBook %}
                {% set headingText = sectionChunks[chunkIndex] or v.book %}
                <h3 class="text-lg font-semibold mt-6">{{ headingText }}</h3>
                {% set prevBook = v.book %}
                {% set chunkIndex = chunkIndex + 1 %}
              {% endif %}
              {% if v.isHeading %}
                <div class="verse missing" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text text-gray-500 italic">Verse text not available.</span></div>
              {% else %}
                {% if v.text and v.text | trim %}
                  <div class="verse" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text">{{ v.text }}</span></div>
                {% else %}
                  <div class="verse missing" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text text-gray-500 italic">Verse text not available.</span></div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="text-sm text-gray-600">LEB not available for {{ slug }} ({{ sectionKey }}).</div>
          {% endif %}
        </div>
      </div>

      <div class="version-group mt-4">
        <h3 class="sr-only">NIRV translation</h3>
        <div class="version nirv server-nirv hidden">
          {% if sectionData.versions.nirv %}
            {% set prevBook = "" %}
            {% set chunkIndex = 0 %}
            {% set sectionChunks = sectionData.chunks | default([]) %}
            {% for v in sectionData.versions.nirv %}
              {% if v.book and v.book != prevBook %}
                {% set headingText = sectionChunks[chunkIndex] or v.book %}
                <h3 class="text-lg font-semibold mt-6">{{ headingText }}</h3>
                {% set prevBook = v.book %}
                {% set chunkIndex = chunkIndex + 1 %}
              {% endif %}
              {% if v.isHeading %}
                <div class="verse missing" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text text-gray-500 italic">Verse text not available.</span></div>
              {% else %}
                {% if v.text and v.text | trim %}
                  <div class="verse" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text">{{ v.text }}</span></div>
                {% else %}
                  <div class="verse missing" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}"> <span class="verse-num font-bold">{{ v.chapter }}:{{ v.verse }}</span> <span class="verse-text text-gray-500 italic">Verse text not available.</span></div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="text-sm text-gray-600">NIRV not available for {{ slug }} ({{ sectionKey }}).</div>
          {% endif %}
        </div>
      </div>

      <div class="version-group mt-4">
        <h3 class="sr-only">Interlinear original languages</h3>
        <div class="version interlinear hidden">
          {% if sectionData.versions.interlinear and sectionData.versions.interlinear | length %}
            {% set prevBook = "" %}
            {% set chunkIndex = 0 %}
            {% set sectionChunks = sectionData.chunks | default([]) %}
            {% for v in sectionData.versions.interlinear %}
              {% if v.book and v.book != prevBook %}
                {% set headingText = sectionChunks[chunkIndex] or v.book %}
                <h3 class="text-lg font-semibold mt-6">{{ headingText }}</h3>
                {% set prevBook = v.book %}
                {% set chunkIndex = chunkIndex + 1 %}
              {% endif %}
              <div class="interlinear-verse mb-4" data-ch="{{ v.chapter }}" data-vs="{{ v.verse }}">
                <span class="verse-num font-bold text-sm mr-2">{{ v.chapter }}:{{ v.verse }}</span>
                <span class="interlinear-words inline-flex flex-wrap gap-x-3 gap-y-2" {% if sectionKey == "torah" or sectionKey == "prophets" %}dir="rtl"{% endif %}>
                  {% if v.words and v.words | length %}
                    {% for w in v.words %}
                      <span class="interlinear-word inline-flex flex-col items-center text-center">
                        <span class="orig text-[2rem] leading-snug" lang="{% if sectionKey == 'torah' or sectionKey == 'prophets' %}hbo{% else %}el{% endif %}">{{ w.orig }}</span>
                        {% if w.translit %}<span class="translit text-xs text-gray-500 italic leading-tight">{{ w.translit }}</span>{% endif %}
                        <span class="gloss text-xs font-medium leading-tight">{{ w.gloss }}</span>
                        {% if w.strongs %}<button class="strongs text-xs text-blue-600 leading-tight hover:underline cursor-pointer bg-transparent border-0 p-0" onclick="openStrongsModal('{{ w.strongs }}')">{{ w.strongs }}</button>{% endif %}
                      </span>
                    {% endfor %}
                  {% else %}
                    <span class="text-sm text-gray-500 italic">Words not available for {{ v.chapter }}:{{ v.verse }}</span>
                  {% endif %}
                </span>
              </div>
            {% endfor %}
          {% else %}
            <div class="text-sm text-gray-600">Interlinear not available for {{ slug }} ({{ sectionKey }}). Run <code>fetch-stepbible-data.js</code> and <code>parse-stepbible.js</code> then rebuild.</div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endmacro %}

<div class="prose max-w-3xl mx-auto py-6">
  {# Version switcher rendered server-side for SEO and no-JS fallback #}
  <div class="bible-version-switcher mb-4" role="tablist" aria-label="Bible version switcher">
    <button type="button" class="px-3 py-1 rounded bg-gray-900 text-white mr-2" data-version="leb" aria-pressed="true">LEB</button>
    <button type="button" class="px-3 py-1 rounded bg-white text-gray-900 border mr-2" data-version="nirv" aria-pressed="false">NIRV</button>
    <button type="button" class="px-3 py-1 rounded bg-white text-gray-900 border mr-2" data-version="interlinear" aria-pressed="false">INTERLINEAR</button>
  </div>

  {% if pr %}
    <div class="bible-passages" data-slug="{{ slug }}">
      {% set chosenSections = ["torah", "gospel", "prophets", "epistles"] %}
      {% set labels = { "torah": "Torah", "gospel": "Gospel", "prophets": "Prophets", "epistles": "Epistles" } %}

      {% set anySectionRendered = false %}
      {% for section in chosenSections %}
        {% if pr[section] is defined and pr[section].passage %}
          {% set anySectionRendered = true %}
          {{ renderSection(section, labels[section], pr[section]) }}
        {% endif %}
      {% endfor %}

      {% if not anySectionRendered %}
        <div class="text-sm text-gray-600">Passages not available for {{ slug }} yet.</div>
      {% endif %}
    </div>
  {% else %}
    <div class="text-sm text-gray-600">Passages not available for {{ slug }} yet.</div>
  {% endif %}
</div>
