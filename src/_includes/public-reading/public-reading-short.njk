{# Schedule embedded for next-reading.js; must precede the includes below, which read window.NextReading #}
<script type="application/json" id="reading-schedule-data">{{ publicreading | dump | replace("<", "\\u003c") | safe }}</script>
<script src="{{ '/assets/js/next-reading.js' | url }}"></script>
<section class="p-8 public-reading-short" id="public-reading-short">
    <span class="pl-8 py-2 font-black lowercase text-4xl">public reading </span>
    <a href="{% if nextReading %}/public-reading/{{ nextReading.slug }}/{% else %}/publicreading/{% endif %}" data-week-link><h2 class="text-2xl font-extralight pl-8 mb-8 mt-1">This Week's Reading <br><span data-week-date class=" text-6xl font-extralight inline-block pt-2">{{ nextReading.date }}</span></h2></a>

{% include "public-reading/this-week-short.njk" %}
{% include "public-reading/upcoming-readings-short.njk" %}

</section>
