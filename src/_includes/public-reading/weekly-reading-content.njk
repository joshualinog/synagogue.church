<article class="max-w-3xl mx-auto py-12 px-4">
  <header class="mb-6">
    <h1 class="text-3xl font-extrabold">{{ reading.torahTitle }} — {{ reading.date }}</h1>
    {% if reading.torahPassage %}<p class="text-sm text-gray-600">Torah: {{ reading.torahPassage }} <span class="ml-2">({{ reading.torahVerseTotal }})</span></p>{% endif %}
    {% if reading.gospelPassage %}<p class="text-sm text-gray-600">Gospel: {{ reading.gospelPassage }} <span class="ml-2">({{ reading.gospelVerseTotal }})</span></p>{% endif %}
  </header>

  <section class="prose">
    {% if reading.notes %}
      <h2>Notes</h2>
      <p>{{ reading.notes }}</p>
    {% endif %}

    {% set isFestival = false %}
    {% if reading.torahTitle %}
      {% set titleLower = reading.torahTitle | lower %}
      {% if "pesach" in titleLower or "sukkot" in titleLower or "yom kippur" in titleLower %}
        {% set isFestival = true %}
      {% endif %}
    {% endif %}

    {% if isFestival %}
      <h2>Festival Readings</h2>
      <ul>
        {% if reading.torahPassage %}<li><strong>Torah:</strong> {{ reading.torahPassage }}</li>{% endif %}
        {% if reading.gospelPassage %}<li><strong>Gospel:</strong> {{ reading.gospelPassage }}</li>{% endif %}
        {% if reading.prophetsPassage %}<li><strong>Prophets:</strong> {{ reading.prophetsPassage }}</li>{% endif %}
        {% if reading.epistlesPassage %}<li><strong>Epistles:</strong> {{ reading.epistlesPassage }}</li>{% endif %}
      </ul>
    {% else %}
      <h2>Passages</h2>
      <ul>
        <li><strong>Torah:</strong> {{ reading.torahPassage }}</li>
        <li><strong>Gospel:</strong> {{ reading.gospelPassage }}</li>
      </ul>
    {% endif %}

    {# Render the passages include which will show translations and provide a version toggle. #}
    {% include "public-reading/passages.njk" %}
  </section>

  <footer class="mt-8">
    <a href="/publicreading/" class="text-sm text-gray-700">Back to all readings</a>
  </footer>
</article>

<script src="/assets/js/bible-toggle.js" defer></script>
