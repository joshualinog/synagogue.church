{% if nextReading %}
<a href="/public-reading/{{ nextReading.slug }}/" class="block px-4">
<div class="bg-green-500 border-2 border-black rounded-2xl overflow-hidden">

    {# ── Row 1: date heading ── #}
    <div class="px-5 py-3 border-b-2 border-black">
      <h2 class="font-black text-4xl tracking-wide lowercase">{{ nextReading.date }} WEEKLY READING</h2>
    </div>

    {# ── Row 2: 4-column reading preview ── #}
    <div class="grid grid-cols-4 h-24">

      {# Col 1 – torah image #}
      <div class="border-r-2 border-black overflow-hidden">
        <img src="assets/images/torahreadingimage.jpeg" alt="Torah reading" class="w-full h-full object-cover" />
      </div>

      {# Col 2 – torah reference #}
      <div class="border-r-2 border-black px-3 py-2 flex flex-col justify-center min-w-0">
        <span class="text-xs font-black uppercase mb-1">Torah</span>
        <span class="text-sm font-extralight leading-tight truncate">{{ nextReading.torahPassage }}</span>
      </div>

      {# Col 3 – gospel image #}
      <div class="border-r-2 border-black overflow-hidden">
        <img src="assets/images/gospelreadingimage.jpeg" alt="Gospel reading" class="w-full h-full object-cover" />
      </div>

      {# Col 4 – gospel reference #}
      <div class="px-3 py-2 flex flex-col justify-center min-w-0">
        <span class="text-xs font-black uppercase mb-1">Gospel</span>
        <span class="text-sm font-extralight leading-tight truncate">{{ nextReading.gospelPassage }}</span>
      </div>

    </div>
  </div>
</a>
{% endif %}
