    "versions": {
      "leb": [
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 24,
          "text": "And Moses listened to the voice of his father-in-law, and he did all that he had said.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 25,
          "text": "And Moses chose men of ability from all Israel, and he appointed them as heads over the people, as commanders of thousands, commanders of hundreds, commanders of fifties, and commanders of tens.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 26,
          "text": "And they judged the people all the time; the difficult issues they would bring to Moses, and every minor issue they would judge themselves.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 27,
          "text": "And Moses let his father-in-law go, and he went to his land.",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 24,
          "text": "Moses listened to his father-in-law. He did everything Jethro said.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 25,
          "text": "He chose men of ability from the whole community of Israel. He made them leaders of the people. They became officials over thousands, hundreds, fifties and tens.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 26,
          "text": "They judged the people at all times. They brought the hard cases to Moses. But they decided the easy ones themselves.",
          "isHeading": false
        },
        {
          "book": "Exod",
          "chapter": 18,
          "verse": 27,
          "text": "Moses sent his father-in-law on his way. So Jethro returned to his own country.",
          "isHeading": false
        }
      ],
