  "gospel": {
    "passage": "Mark 7:17 - 7:23",
    "chunks": [
      "Mark 7:17 - 7:23"
    ],
    "versions": {
      "leb": [
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 17,
          "text": "And when he entered into the house away from the crowd, his disciples asked him about the parable.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 18,
          "text": "And he said to them, “So are you also without understanding? Do you not understand that everything that is outside that goes into a person is not able to defile him?",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 19,
          "text": "For it does not enter into his heart but into his stomach, and goes out into the latrine”—thus declaring all foods clean.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 20,
          "text": "And he said, “What comes out of a person, that defiles a person.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 21,
          "text": "For from within, from the heart of people, come evil plans, sexual immoralities, thefts, murders,",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 22,
          "text": "adulteries, acts of greed, malicious deeds, deceit, licentiousness, envy, abusive speech, pride, foolishness.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 23,
          "text": "All these evil things come from within and defile a person.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 17,
          "text": "Then he left the crowd and entered the house. His disciples asked him about this teaching.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 18,
          "text": "“Don’t you understand?” Jesus asked. “Don’t you see? Nothing that enters people from the outside can make them ‘unclean.’",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 19,
          "text": "It doesn’t go into the heart. It goes into the stomach. Then it goes out of the body.” In saying this, Jesus was calling all foods “clean.”",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 20,
          "text": "He went on to say, “What comes out of people makes them ‘unclean.’",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 21,
          "text": "Evil thoughts come from the inside, from people’s hearts. So do sexual sins, stealing and murder. Adultery,",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 22,
          "text": "greed, hate and cheating come from people’s hearts too. So do desires that are not pure, and wanting what belongs to others. And so do telling lies about others and being proud and being foolish.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 7,
          "verse": 23,
          "text": "All those evil things come from inside a person. They make him ‘unclean.’”",
          "isHeading": false
        }
      ],
