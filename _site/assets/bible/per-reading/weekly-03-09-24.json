    "versions": {
      "leb": [
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 34,
          "text": "Taking Up One’s Cross to Follow Jesus\nAnd summoning the crowd together with his disciples, he said to them, “If anyone wants to come after me, let him deny himself and take up his cross and follow me.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 35,
          "text": "For whoever wants to save his life will lose it, but whoever loses his life on account of me and of the gospel will save it.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 36,
          "text": "For what does it benefit a person to gain the whole world and forfeit his life?",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 37,
          "text": "For what can a person give in exchange for his life?",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 38,
          "text": "For whoever is ashamed of me and my words in this adulterous and sinful generation, the Son of Man will also be ashamed of him when he comes in the glory of his Father with the holy angels.”",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 9,
          "verse": 1,
          "text": "And he said to them, “Truly I say to you, that there are some of those standing here who will never experience death until they see the kingdom of God having come with power.”",
          "isHeading": false
        }
      ],
      "nirv": [
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 34,
          "text": "Jesus called the crowd to him along with his disciples. He said, “If anyone wants to come after me, he must say no to himself. He must pick up his cross and follow me.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 35,
          "text": "If he wants to save his life, he will lose it. But if he loses his life for me and for the good news, he will save it.",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 36,
          "text": "What good is it if someone gains the whole world but loses his soul?",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 37,
          "text": "Or what can anyone trade for his soul?",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 8,
          "verse": 38,
          "text": "“Suppose you are ashamed of me and my words among these adulterous and sinful people. Then the Son of Man will be ashamed of you when he comes in his Father’s glory with the holy angels.”",
          "isHeading": false
        },
        {
          "book": "Mark",
          "chapter": 9,
          "verse": 1,
          "text": "Jesus said to them, “What I’m about to tell you is true. Some who are standing here will not die before they see God’s kingdom coming with power.”",
          "isHeading": false
        }
      ],
